{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simcode4d.org/schemas/rc3a-dev1/case-spec.json",
  "title": "SimCode4D RC3A development case specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "case_id", "world_id", "domain", "split",
    "task_family", "dynamic_subtype", "prompt", "source", "artifacts",
    "entities", "observation", "probe", "validator", "simulator",
    "ownership", "semantic_review"
  ],
  "properties": {
    "schema_version": {"const": "simcode4d.rc3a-dev1.case-spec"},
    "case_id": {"type": "string", "pattern": "^[A-Z]{3}-[0-9]{2}-[a-z0-9-]+$"},
    "world_id": {"type": "string", "minLength": 3},
    "domain": {"enum": ["natural_outdoor", "service", "indoor", "industrial", "urban"]},
    "split": {"const": "development"},
    "task_family": {
      "enum": [
        "pick_and_place", "push_to_region", "put_into_container",
        "obstacle_navigation", "dynamic_interaction"
      ]
    },
    "dynamic_subtype": {
      "type": ["string", "null"],
      "enum": [null, "articulated", "contact_dynamic", "cross_medium", "other_typed"]
    },
    "prompt": {"type": "string", "minLength": 8},
    "source": {"$ref": "#/$defs/file_ref"},
    "source_manifest": {"$ref": "#/$defs/file_ref"},
    "source_lineage_status": {
      "enum": ["verified", "verified_reexport", "pending_reexport", "compiled_m1_only_authoring_source_missing"]
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["m1_base", "m2_overlay", "runtime_model", "dependency_manifest"],
      "properties": {
        "m1_base": {"$ref": "#/$defs/file_ref"},
        "m2_overlay": {"$ref": "#/$defs/file_ref"},
        "runtime_model": {"$ref": "#/$defs/file_ref"},
        "dependency_manifest": {"$ref": "#/$defs/file_ref"}
      }
    },
    "entities": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entity_id", "role", "mobility", "model_binding", "required"],
        "properties": {
          "entity_id": {"type": "string"},
          "role": {"type": "string"},
          "mobility": {"enum": ["fixed", "free", "articulated", "field", "visual_only"]},
          "model_binding": {"type": "string"},
          "required": {"type": "boolean"},
          "assembly_members": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bodies", "joints"],
      "properties": {
        "bodies": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "joints": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "probe": {
      "type": "object",
      "required": [
        "owner", "path", "sha256", "episode_duration_s", "log_hz",
        "actuator_limits", "waypoints_xy"
      ],
      "properties": {
        "owner": {"const": "benchmark"},
        "path": {"type": "string"},
        "support_modules": {"type": "array", "items": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}}}},
        "reference_yaw_rad": {"type": "array", "items": {"type": "number"}},
        "sha256": {"$ref": "#/$defs/sha256"},
        "episode_duration_s": {"type": "number", "exclusiveMinimum": 0},
        "log_hz": {"const": 30},
        "actuator_limits": {"type": "object"},
        "waypoints_xy": {"type": "array"},
        "grasp_api": {"type": "object"}
      }
    },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "path", "sha256", "support_modules"],
      "properties": {
        "owner": {"const": "benchmark"},
        "path": {"type": "string"},
        "support_modules": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}}}},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "simulator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "timestep_s"],
      "properties": {
        "name": {"const": "mujoco"},
        "version": {"type": "string"},
        "timestep_s": {"const": 0.001}
      }
    },
    "static_field": {"type": "object"},
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["m1", "m2", "benchmark_overlay"],
      "properties": {
        "m1": {"type": "string"},
        "m2": {"type": "string"},
        "benchmark_overlay": {"type": "string"}
      }
    },
    "semantic_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "formal_double_annotation", "frozen_before_runs", "basis"],
      "properties": {
        "status": {"const": "development_frozen"},
        "formal_double_annotation": {"const": false},
        "frozen_before_runs": {"const": true},
        "basis": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "official_admission": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
