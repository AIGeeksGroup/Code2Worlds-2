{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simcode4d.org/schemas/dev15/task-confirm-v1.json",
  "title": "SimCode4D Dev15 task confirmation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "case_id", "world_id", "canonical_source", "robot",
    "task", "task_family", "dynamic_subtype", "start_state", "goal",
    "required_event_order", "allowed_contacts", "forbidden_contacts",
    "contact_group_bindings", "timeout_s", "success_tolerance", "review"
  ],
  "properties": {
    "schema_version": {"const": "simcode4d.dev15.task-confirm.v1"},
    "case_id": {"type": "string", "pattern": "^[A-Z]{3}-[0-9]{2}-[a-z0-9-]+$"},
    "world_id": {"type": "string", "minLength": 3},
    "canonical_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "lineage_status"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1},
        "lineage_status": {"enum": ["verified", "verified_reexport", "pending_reexport", "compiled_m1_only_authoring_source_missing"]}
      }
    },
    "robot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "entity_id", "model_binding", "mobility"],
      "properties": {
        "name": {"type": "string", "minLength": 2},
        "entity_id": {"type": "string", "minLength": 1},
        "model_binding": {"type": "string", "minLength": 1},
        "mobility": {"enum": ["free", "articulated"]}
      }
    },
    "task": {"type": "string", "minLength": 8},
    "task_family": {"type": "string", "minLength": 3},
    "dynamic_subtype": {"type": ["string", "null"]},
    "start_state": {"type": "object"},
    "goal": {"type": "object", "minProperties": 1},
    "required_event_order": {"$ref": "#/$defs/event_dag"},
    "allowed_contacts": {"type": "array", "items": {"$ref": "#/$defs/semantic_pair"}},
    "forbidden_contacts": {"type": "array", "items": {"$ref": "#/$defs/semantic_pair"}},
    "contact_group_bindings": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/group_binding"}
    },
    "timeout_s": {"type": "number", "exclusiveMinimum": 0},
    "success_tolerance": {
      "type": "object",
      "minProperties": 2,
      "required": ["illegal_penetration_m", "terminal_hold_s"]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "basis", "frozen_before_reference_runs",
        "formal_annotator_count", "official_core15_use", "note"
      ],
      "properties": {
        "status": {"const": "benchmark_authored_development_frozen"},
        "basis": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "frozen_before_reference_runs": {"const": true},
        "formal_annotator_count": {"const": 0},
        "official_core15_use": {"const": false},
        "note": {"type": "string"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "semantic_pair": {
      "type": "array",
      "prefixItems": [{"type": "string"}, {"type": "string"}],
      "minItems": 2,
      "maxItems": 2
    },
    "event_dag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
        "edges": {"type": "array", "items": {"$ref": "#/$defs/semantic_pair"}}
      }
    },
    "group_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "geoms": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "bodies": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "active_when": {
          "type": "object",
          "additionalProperties": false,
          "required": ["joint"],
          "properties": {
            "joint": {"type": "string", "minLength": 1},
            "minimum_position": {"type": "number"},
            "maximum_position": {"type": "number"}
          },
          "anyOf": [{"required": ["minimum_position"]}, {"required": ["maximum_position"]}]
        }
      },
      "anyOf": [{"required": ["geoms"]}, {"required": ["bodies"]}]
    }
  }
}
